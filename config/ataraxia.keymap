#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// ROW 0
&kp N1    &kp N2 &kp N3 &kp N4 &kp N5 &kp N6        &kp N7 &kp N8 &kp N9 &kp N0    &kp EQUAL &kp BSPC
// ROW 1
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y  &kp U  &kp I  &kp O     &kp P     &kp RET
// ROW 2
&kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G         &kp H  &kp J  &kp K  &kp L     &kp SEMI  &kp RSHFT
// ROW 3
&kp LCTRL &kp Z  &kp X  &kp C  &kp V  &kp B         &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH  &kp RCTRL
// ROW 4 (THUMB KEYS)
                               &kp SPACE &kp BSPC   &ht RET ESC &kp SPACE
            >;
        };
    };
};